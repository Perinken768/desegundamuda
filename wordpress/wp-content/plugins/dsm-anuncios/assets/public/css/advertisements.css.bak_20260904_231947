/**
 * DSM Anuncios
 * Marketplace público.
 */

.dsm-marketplace {
    --dsm-color-primary: #2271b1;
    --dsm-color-primary-dark: #135e96;
    --dsm-color-primary-soft: #eaf4fb;
    --dsm-color-text: #1d2327;
    --dsm-color-muted: #646970;
    --dsm-color-border: #dcdcde;
    --dsm-color-background: #f6f7f7;
    --dsm-color-surface: #ffffff;
    --dsm-color-success: #008a20;
    --dsm-color-success-soft: #edfaef;
    --dsm-color-warning: #996800;
    --dsm-color-warning-soft: #fff8e5;
    --dsm-color-danger: #b32d2e;
    --dsm-color-promoted: #7a3e00;
    --dsm-color-promoted-soft: #fff2cc;
    --dsm-radius-small: 6px;
    --dsm-radius-medium: 10px;
    --dsm-radius-large: 16px;
    --dsm-shadow-small:
        0 1px 2px rgba(0, 0, 0, 0.06);
    --dsm-shadow-medium:
        0 8px 24px rgba(0, 0, 0, 0.08);

    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    color: var(--dsm-color-text);
    font-family: inherit;
}

.dsm-marketplace *,
.dsm-marketplace *::before,
.dsm-marketplace *::after {
    box-sizing: border-box;
}

.dsm-marketplace a {
    color: inherit;
}

.dsm-marketplace img {
    max-width: 100%;
}

/* Cabecera */

.dsm-marketplace__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
}

.dsm-marketplace__heading {
    min-width: 0;
}

.dsm-marketplace__title {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    line-height: 1.1;
    color: var(--dsm-color-text);
}

.dsm-marketplace__description {
    max-width: 760px;
    margin: 10px 0 0;
    color: var(--dsm-color-muted);
    font-size: 1rem;
    line-height: 1.55;
}

.dsm-marketplace__result-count {
    flex: 0 0 auto;
    color: var(--dsm-color-muted);
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
}

/* Categorías */

.dsm-marketplace-categories {
    display: flex;
    gap: 10px;
    margin-bottom: 24px;
    padding-bottom: 4px;
    overflow-x: auto;
    scrollbar-width: thin;
}

.dsm-marketplace-category {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 15px;
    border: 1px solid var(--dsm-color-border);
    border-radius: 999px;
    background: var(--dsm-color-surface);
    color: var(--dsm-color-text);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
        border-color 0.15s ease,
        background-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease;
}

.dsm-marketplace-category:hover,
.dsm-marketplace-category:focus-visible {
    border-color: var(--dsm-color-primary);
    color: var(--dsm-color-primary);
    transform: translateY(-1px);
}

.dsm-marketplace-category.is-active {
    border-color: var(--dsm-color-primary);
    background: var(--dsm-color-primary);
    color: #ffffff;
}

/* Formulario de búsqueda y filtros */

.dsm-marketplace-filters {
    margin-bottom: 26px;
    padding: 20px;
    border: 1px solid var(--dsm-color-border);
    border-radius: var(--dsm-radius-large);
    background: var(--dsm-color-surface);
    box-shadow: var(--dsm-shadow-small);
}

.dsm-marketplace-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding: 6px;
    border: 1px solid var(--dsm-color-border);
    border-radius: var(--dsm-radius-medium);
    background: var(--dsm-color-background);
}

.dsm-marketplace-search:focus-within {
    border-color: var(--dsm-color-primary);
    box-shadow:
        0 0 0 1px var(--dsm-color-primary);
}

.dsm-marketplace-search .dashicons {
    margin-left: 8px;
    color: var(--dsm-color-muted);
}

.dsm-marketplace-search input[type="search"] {
    width: 100%;
    min-width: 0;
    min-height: 42px;
    padding: 8px 4px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--dsm-color-text);
    font: inherit;
}

.dsm-marketplace-search input[type="search"]::placeholder {
    color: #8c8f94;
}

.dsm-marketplace-filter-grid {
    display: grid;
    grid-template-columns:
        repeat(
            4,
            minmax(160px, 1fr)
        );
    gap: 16px;
}

.dsm-filter-field {
    min-width: 0;
}

.dsm-filter-field label {
    display: block;
    margin-bottom: 6px;
    color: var(--dsm-color-text);
    font-size: 0.85rem;
    font-weight: 700;
}

.dsm-filter-field select,
.dsm-filter-field input[type="text"],
.dsm-filter-field input[type="search"],
.dsm-filter-field input[type="number"] {
    width: 100%;
    min-height: 42px;
    margin: 0;
    padding: 8px 11px;
    border: 1px solid var(--dsm-color-border);
    border-radius: var(--dsm-radius-small);
    background: var(--dsm-color-surface);
    color: var(--dsm-color-text);
    font: inherit;
    line-height: 1.3;
}

.dsm-filter-field select:focus,
.dsm-filter-field input:focus {
    border-color: var(--dsm-color-primary);
    outline: none;
    box-shadow:
        0 0 0 1px var(--dsm-color-primary);
}

.dsm-price-input {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    border: 1px solid var(--dsm-color-border);
    border-radius: var(--dsm-radius-small);
    background: var(--dsm-color-surface);
    overflow: hidden;
}

.dsm-price-input:focus-within {
    border-color: var(--dsm-color-primary);
    box-shadow:
        0 0 0 1px var(--dsm-color-primary);
}

.dsm-price-input input[type="number"] {
    border: 0;
    border-radius: 0;
    box-shadow: none;
}

.dsm-price-input span {
    padding: 0 12px;
    color: var(--dsm-color-muted);
    font-weight: 700;
}

.dsm-marketplace-filter-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

/* Botones */

.dsm-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 9px 17px;
    border: 1px solid transparent;
    border-radius: var(--dsm-radius-small);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease;
}

.dsm-button:hover,
.dsm-button:focus-visible {
    transform: translateY(-1px);
}

.dsm-button--primary {
    border-color: var(--dsm-color-primary);
    background: var(--dsm-color-primary);
    color: #ffffff;
}

.dsm-button--primary:hover,
.dsm-button--primary:focus-visible {
    border-color: var(--dsm-color-primary-dark);
    background: var(--dsm-color-primary-dark);
    color: #ffffff;
}

.dsm-button--secondary {
    border-color: var(--dsm-color-border);
    background: var(--dsm-color-surface);
    color: var(--dsm-color-text);
}

.dsm-button--secondary:hover,
.dsm-button--secondary:focus-visible {
    border-color: var(--dsm-color-primary);
    color: var(--dsm-color-primary);
}

/* Filtros activos */

.dsm-marketplace-active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -8px 0 22px;
}

.dsm-active-filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 999px;
    background: var(--dsm-color-primary-soft);
    color: var(--dsm-color-primary-dark);
    font-size: 0.85rem;
    font-weight: 700;
}

.dsm-active-filter a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: inherit;
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
}

.dsm-active-filter a:hover,
.dsm-active-filter a:focus-visible {
    background: rgba(0, 0, 0, 0.08);
}

/* Cuadrícula */

.dsm-advertisement-grid {
    display: grid;
    grid-template-columns:
        repeat(
            4,
            minmax(0, 1fr)
        );
    gap: 22px;
}

/* Tarjeta */

.dsm-advertisement-card {
    position: relative;
    min-width: 0;
    border: 1px solid var(--dsm-color-border);
    border-radius: var(--dsm-radius-large);
    background: var(--dsm-color-surface);
    box-shadow: var(--dsm-shadow-small);
    overflow: hidden;
    transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
}

.dsm-advertisement-card:hover {
    transform: translateY(-3px);
    border-color: #c3c4c7;
    box-shadow: var(--dsm-shadow-medium);
}

.dsm-advertisement-card.is-promoted {
    border-color: #e2b23b;
}

.dsm-advertisement-card.is-reserved {
    opacity: 0.92;
}

.dsm-advertisement-card__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
}

.dsm-advertisement-card__image {
    position: relative;
    aspect-ratio: 4 / 5;
    background:
        linear-gradient(
            135deg,
            #f0f0f1,
            #f6f7f7
        );
    overflow: hidden;
}

.dsm-advertisement-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
        transform 0.28s ease;
}

.dsm-advertisement-card:hover
.dsm-advertisement-card__image img {
    transform: scale(1.025);
}

.dsm-advertisement-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #a7aaad;
}

.dsm-advertisement-card__placeholder .dashicons {
    width: auto;
    height: auto;
    font-size: 44px;
}

.dsm-advertisement-card__badges {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    pointer-events: none;
}

.dsm-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 27px;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 800;
    line-height: 1;
    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.12);
}

.dsm-badge .dashicons {
    width: auto;
    height: auto;
    font-size: 14px;
}

.dsm-badge--promoted {
    background: var(--dsm-color-promoted-soft);
    color: var(--dsm-color-promoted);
}

.dsm-badge--reserved {
    background: var(--dsm-color-warning-soft);
    color: var(--dsm-color-warning);
}

.dsm-advertisement-card__content {
    padding: 16px;
}

.dsm-advertisement-card__category {
    min-height: 18px;
    margin-bottom: 5px;
    color: var(--dsm-color-muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
}

.dsm-advertisement-card__title {
    margin: 0;
    color: var(--dsm-color-text);
    font-size: 1.03rem;
    line-height: 1.35;
}

.dsm-advertisement-card__title a {
    display: -webkit-box;
    overflow: hidden;

    color: inherit;
    text-decoration: none;

    -webkit-box-orient: vertical;

    /* Propiedad estándar */
    line-clamp: 2;

    /* Compatibilidad actual */
    -webkit-line-clamp: 2;
}

.dsm-advertisement-card__title a:hover,
.dsm-advertisement-card__title a:focus-visible {
    color: var(--dsm-color-primary);
}

.dsm-advertisement-card__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
}

.dsm-advertisement-card__price strong {
    color: var(--dsm-color-text);
    font-size: 1.18rem;
}

.dsm-advertisement-card__price del {
    color: var(--dsm-color-muted);
    font-size: 0.85rem;
}

.dsm-advertisement-card__attributes {
    display: grid;
    gap: 7px;
    margin: 14px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid #f0f0f1;
}

.dsm-advertisement-card__attributes > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 7px;
    min-width: 0;
}

.dsm-advertisement-card__attributes dt,
.dsm-advertisement-card__attributes dd {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.35;
}

.dsm-advertisement-card__attributes dt {
    color: var(--dsm-color-muted);
    font-weight: 600;
}

.dsm-advertisement-card__attributes dd {
    min-width: 0;
    color: var(--dsm-color-text);
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dsm-advertisement-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 15px;
    padding-top: 12px;
    border-top: 1px solid #f0f0f1;
    color: var(--dsm-color-muted);
    font-size: 0.76rem;
}

.dsm-advertisement-card__seller {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 7px;
}

.dsm-advertisement-card__seller img {
    flex: 0 0 auto;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    object-fit: cover;
}

.dsm-advertisement-card__seller .dashicons {
    flex: 0 0 auto;
    width: auto;
    height: auto;
    font-size: 22px;
}

.dsm-advertisement-card__seller span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dsm-advertisement-card__footer time {
    flex: 0 0 auto;
    white-space: nowrap;
}

/* Estado vacío */

.dsm-marketplace-empty {
    padding: 60px 24px;
    border: 1px dashed var(--dsm-color-border);
    border-radius: var(--dsm-radius-large);
    background: var(--dsm-color-background);
    text-align: center;
}

.dsm-marketplace-empty > .dashicons {
    width: auto;
    height: auto;
    color: #8c8f94;
    font-size: 52px;
}

.dsm-marketplace-empty h2 {
    margin: 14px 0 6px;
    font-size: 1.35rem;
}

.dsm-marketplace-empty p {
    margin: 0 0 20px;
    color: var(--dsm-color-muted);
}

/* Error */

.dsm-advertisements-error {
    padding: 15px 18px;
    border-left: 4px solid var(--dsm-color-danger);
    border-radius: var(--dsm-radius-small);
    background: #fcf0f1;
    color: var(--dsm-color-danger);
}

/* Paginación */

.dsm-marketplace-pagination {
    display: grid;
    grid-template-columns: minmax(100px, 1fr) auto minmax(100px, 1fr);
    align-items: center;
    gap: 16px;
    margin-top: 32px;
}

.dsm-pagination-pages {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
}

.dsm-pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    padding: 7px 10px;
    border: 1px solid var(--dsm-color-border);
    border-radius: var(--dsm-radius-small);
    background: var(--dsm-color-surface);
    color: var(--dsm-color-text);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
        border-color 0.15s ease,
        background-color 0.15s ease,
        color 0.15s ease;
}

.dsm-pagination-link:hover,
.dsm-pagination-link:focus-visible {
    border-color: var(--dsm-color-primary);
    color: var(--dsm-color-primary);
}

.dsm-pagination-link.is-current {
    border-color: var(--dsm-color-primary);
    background: var(--dsm-color-primary);
    color: #ffffff;
}

.dsm-pagination-link--previous {
    justify-self: start;
}

.dsm-pagination-link--next {
    justify-self: end;
}

.dsm-pagination-ellipsis {
    color: var(--dsm-color-muted);
}

/* Accesibilidad */

.dsm-marketplace
.screen-reader-text {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    border: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
}

.dsm-marketplace
.screen-reader-text:focus {
    position: fixed !important;
    top: 10px;
    left: 10px;
    z-index: 100000;
    width: auto;
    height: auto;
    padding: 10px 14px;
    margin: 0;
    clip: auto;
    background: #ffffff;
    color: var(--dsm-color-text);
}

/* Tablets */

@media (max-width: 1100px) {
    .dsm-marketplace-filter-grid {
        grid-template-columns:
            repeat(
                3,
                minmax(150px, 1fr)
            );
    }

    .dsm-advertisement-grid {
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
    }
}

@media (max-width: 820px) {
    .dsm-marketplace__header {
        align-items: flex-start;
        flex-direction: column;
        gap: 10px;
    }

    .dsm-marketplace-filter-grid {
        grid-template-columns:
            repeat(
                2,
                minmax(140px, 1fr)
            );
    }

    .dsm-advertisement-grid {
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
    }

    .dsm-marketplace-pagination {
        grid-template-columns: 1fr;
    }

    .dsm-pagination-link--previous,
    .dsm-pagination-link--next {
        justify-self: center;
    }

    .dsm-pagination-link--previous {
        order: 2;
    }

    .dsm-pagination-pages {
        order: 1;
    }

    .dsm-pagination-link--next {
        order: 3;
    }
}

/* Móviles */

@media (max-width: 560px) {
    .dsm-marketplace-filters {
        padding: 14px;
        border-radius: var(--dsm-radius-medium);
    }

    .dsm-marketplace-search {
        grid-template-columns: auto minmax(0, 1fr);
    }

    .dsm-marketplace-search .dsm-button {
        grid-column: 1 / -1;
        width: 100%;
    }

    .dsm-marketplace-filter-grid {
        grid-template-columns: 1fr;
        gap: 13px;
    }

    .dsm-marketplace-filter-actions {
        flex-direction: column;
    }

    .dsm-marketplace-filter-actions
    .dsm-button {
        width: 100%;
    }

    .dsm-advertisement-grid {
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
        gap: 12px;
    }

    .dsm-advertisement-card {
        border-radius: var(--dsm-radius-medium);
    }

    .dsm-advertisement-card__content {
        padding: 11px;
    }

    .dsm-advertisement-card__category {
        font-size: 0.66rem;
    }

    .dsm-advertisement-card__title {
        font-size: 0.9rem;
    }

    .dsm-advertisement-card__price {
        margin-top: 8px;
    }

    .dsm-advertisement-card__price strong {
        font-size: 1rem;
    }

    .dsm-advertisement-card__attributes {
        display: none;
    }

    .dsm-advertisement-card__footer {
        margin-top: 10px;
        padding-top: 9px;
    }

    .dsm-advertisement-card__footer time {
        display: none;
    }

    .dsm-advertisement-card__seller {
        width: 100%;
    }

    .dsm-advertisement-card__badges {
        top: 8px;
        left: 8px;
        right: 8px;
    }

    .dsm-badge {
        min-height: 23px;
        padding: 4px 7px;
        font-size: 0.64rem;
    }
}

@media (max-width: 380px) {
    .dsm-advertisement-grid {
        grid-template-columns: 1fr;
    }
}

/* Preferencia de movimiento reducido */

@media (prefers-reduced-motion: reduce) {
    .dsm-marketplace *,
    .dsm-marketplace *::before,
    .dsm-marketplace *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}

/* ==========================================================
   FICHA PÚBLICA DEL ANUNCIO
   ========================================================== */

.dsm-advertisement-page {
    width: 100%;
}

.dsm-advertisement-page__container {
    width: min(100% - 32px, 1440px);
    margin: 0 auto;
    padding: 32px 0 56px;
}

.dsm-advertisement-detail {
    --dsm-detail-text: #1d2327;
    --dsm-detail-muted: #646970;
    --dsm-detail-border: #dcdcde;
    --dsm-detail-surface: #ffffff;
    --dsm-detail-background: #f6f7f7;
    --dsm-detail-primary: #2271b1;
    --dsm-detail-primary-dark: #135e96;
    --dsm-detail-success: #008a20;
    --dsm-detail-success-soft: #edfaef;
    --dsm-detail-warning: #996800;
    --dsm-detail-warning-soft: #fff8e5;
    --dsm-detail-promoted: #7a3e00;
    --dsm-detail-promoted-soft: #fff2cc;
    --dsm-detail-radius-small: 6px;
    --dsm-detail-radius-medium: 10px;
    --dsm-detail-radius-large: 16px;
    --dsm-detail-shadow:
        0 8px 24px rgba(0, 0, 0, 0.08);

    width: 100%;
    color: var(--dsm-detail-text);
}

.dsm-advertisement-detail *,
.dsm-advertisement-detail *::before,
.dsm-advertisement-detail *::after {
    box-sizing: border-box;
}

.dsm-advertisement-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 22px;
    color: var(--dsm-detail-muted);
    font-size: 0.87rem;
}

.dsm-advertisement-breadcrumbs a {
    color: inherit;
    text-decoration: none;
}

.dsm-advertisement-breadcrumbs a:hover,
.dsm-advertisement-breadcrumbs a:focus-visible {
    color: var(--dsm-detail-primary);
}

.dsm-advertisement-breadcrumbs [aria-current="page"] {
    color: var(--dsm-detail-text);
    font-weight: 600;
}

.dsm-advertisement-detail__layout {
    display: grid;
    grid-template-columns:
        minmax(0, 1.55fr)
        minmax(320px, 0.75fr);
    gap: 30px;
    align-items: start;
}

.dsm-advertisement-gallery,
.dsm-advertisement-summary,
.dsm-advertisement-description,
.dsm-advertisement-seller {
    min-width: 0;
}

.dsm-advertisement-gallery__main {
    position: relative;
    display: flex;
    min-height: 620px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--dsm-detail-border);
    border-radius: var(--dsm-detail-radius-large);
    background:
        linear-gradient(
            135deg,
            #f0f0f1,
            #f6f7f7
        );
}

.dsm-advertisement-gallery__main img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 620px;
    max-height: 760px;
    object-fit: contain;
    background: var(--dsm-detail-background);
}

.dsm-advertisement-gallery__placeholder {
    display: flex;
    min-height: 620px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 30px;
    color: #8c8f94;
    text-align: center;
}

.dsm-advertisement-gallery__placeholder .dashicons {
    width: auto;
    height: auto;
    font-size: 64px;
}

.dsm-advertisement-detail__badges {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    pointer-events: none;
}

.dsm-advertisement-gallery__thumbnails {
    display: grid;
    grid-template-columns:
        repeat(
            auto-fill,
            minmax(82px, 1fr)
        );
    gap: 10px;
    margin-top: 12px;
}

.dsm-advertisement-gallery__thumbnail {
    position: relative;
    aspect-ratio: 1 / 1;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--dsm-detail-radius-small);
    background: var(--dsm-detail-background);
    cursor: pointer;
    transition:
        border-color 0.15s ease,
        transform 0.15s ease,
        opacity 0.15s ease;
}

.dsm-advertisement-gallery__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.dsm-advertisement-gallery__thumbnail:hover,
.dsm-advertisement-gallery__thumbnail:focus-visible {
    transform: translateY(-1px);
    border-color: #a7aaad;
    outline: none;
}

.dsm-advertisement-gallery__thumbnail.is-active {
    border-color: var(--dsm-detail-primary);
}

.dsm-advertisement-gallery__thumbnail.has-error {
    opacity: 0.45;
}

.dsm-advertisement-summary {
    position: sticky;
    top: 24px;
    padding: 24px;
    border: 1px solid var(--dsm-detail-border);
    border-radius: var(--dsm-detail-radius-large);
    background: var(--dsm-detail-surface);
    box-shadow: var(--dsm-detail-shadow);
}

.dsm-advertisement-summary__category {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--dsm-detail-primary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
}

.dsm-advertisement-summary__category:hover,
.dsm-advertisement-summary__category:focus-visible {
    color: var(--dsm-detail-primary-dark);
}

.dsm-advertisement-summary__title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.45rem);
    line-height: 1.15;
}

.dsm-advertisement-summary__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

.dsm-advertisement-summary__price strong {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1;
}

.dsm-advertisement-summary__price del {
    color: var(--dsm-detail-muted);
    font-size: 1rem;
}

.dsm-advertisement-summary__discount {
    display: inline-flex;
    align-items: center;
    min-height: 27px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--dsm-detail-success-soft);
    color: var(--dsm-detail-success);
    font-size: 0.78rem;
    font-weight: 800;
}

.dsm-advertisement-summary__published {
    margin: 12px 0 0;
    color: var(--dsm-detail-muted);
    font-size: 0.86rem;
}

.dsm-advertisement-summary__attributes {
    display: grid;
    gap: 0;
    margin: 22px 0 0;
}

.dsm-advertisement-summary__attributes > div {
    display: grid;
    grid-template-columns:
        minmax(110px, 0.7fr)
        minmax(0, 1fr);
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid #f0f0f1;
}

.dsm-advertisement-summary__attributes > div:last-child {
    border-bottom: 0;
}

.dsm-advertisement-summary__attributes dt,
.dsm-advertisement-summary__attributes dd {
    margin: 0;
}

.dsm-advertisement-summary__attributes dt {
    color: var(--dsm-detail-muted);
    font-size: 0.86rem;
    font-weight: 600;
}

.dsm-advertisement-summary__attributes dd {
    min-width: 0;
    font-size: 0.9rem;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.dsm-advertisement-actions {
    display: grid;
    gap: 10px;
    margin-top: 22px;
}

.dsm-advertisement-actions .dsm-button {
    width: 100%;
}

.dsm-advertisement-actions__owner-notice,
.dsm-advertisement-actions__reserved-notice {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 12px 14px;
    border-radius: var(--dsm-detail-radius-small);
    font-size: 0.88rem;
    line-height: 1.4;
}

.dsm-advertisement-actions__owner-notice {
    background: #eaf4fb;
    color: var(--dsm-detail-primary-dark);
}

.dsm-advertisement-actions__reserved-notice {
    background: var(--dsm-detail-warning-soft);
    color: var(--dsm-detail-warning);
}

.dsm-advertisement-actions__owner-notice .dashicons,
.dsm-advertisement-actions__reserved-notice .dashicons {
    flex: 0 0 auto;
    width: auto;
    height: auto;
    margin-top: 1px;
    font-size: 18px;
}

.dsm-button--success {
    border-color: var(--dsm-detail-success);
    background: var(--dsm-detail-success);
    color: #ffffff;
}

.dsm-button--success:hover,
.dsm-button--success:focus-visible {
    border-color: #006b1b;
    background: #006b1b;
    color: #ffffff;
}

.dsm-button--promoted {
    border-color: #dba617;
    background: var(--dsm-detail-promoted-soft);
    color: var(--dsm-detail-promoted);
}

.dsm-button--promoted:hover,
.dsm-button--promoted:focus-visible {
    border-color: #b8860b;
    background: #ffe7a3;
    color: var(--dsm-detail-promoted);
}

.dsm-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
}

.dsm-advertisement-promotion-info {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 11px 13px;
    border-radius: var(--dsm-detail-radius-small);
    background: var(--dsm-detail-promoted-soft);
    color: var(--dsm-detail-promoted);
    font-size: 0.85rem;
    font-weight: 700;
}

.dsm-advertisement-promotion-info .dashicons {
    width: auto;
    height: auto;
    font-size: 17px;
}

.dsm-advertisement-detail__lower {
    display: grid;
    grid-template-columns:
        minmax(0, 1.55fr)
        minmax(320px, 0.75fr);
    gap: 30px;
    margin-top: 30px;
    align-items: start;
}

.dsm-advertisement-description,
.dsm-advertisement-seller {
    padding: 24px;
    border: 1px solid var(--dsm-detail-border);
    border-radius: var(--dsm-detail-radius-large);
    background: var(--dsm-detail-surface);
}

.dsm-advertisement-description h2,
.dsm-advertisement-seller h2 {
    margin: 0 0 18px;
    font-size: 1.35rem;
}

.dsm-advertisement-description__content {
    color: var(--dsm-detail-text);
    line-height: 1.7;
}

.dsm-advertisement-description__content p:first-child {
    margin-top: 0;
}

.dsm-advertisement-description__content p:last-child {
    margin-bottom: 0;
}

.dsm-advertisement-description__updated {
    margin: 20px 0 0;
    padding-top: 15px;
    border-top: 1px solid #f0f0f1;
    color: var(--dsm-detail-muted);
    font-size: 0.8rem;
}

.dsm-advertisement-seller__identity {
    display: flex;
    align-items: center;
    gap: 14px;
}

.dsm-advertisement-seller__identity img,
.dsm-advertisement-seller__avatar-placeholder {
    display: flex;
    width: 62px;
    height: 62px;
    flex: 0 0 62px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--dsm-detail-border);
    border-radius: 50%;
    background: var(--dsm-detail-background);
}

.dsm-advertisement-seller__identity img {
    object-fit: cover;
}

.dsm-advertisement-seller__avatar-placeholder .dashicons {
    width: auto;
    height: auto;
    color: #8c8f94;
    font-size: 34px;
}

.dsm-advertisement-seller__identity > div {
    min-width: 0;
}

.dsm-advertisement-seller__name {
    display: block;
    min-width: 0;
    color: var(--dsm-detail-text);
    font-size: 1rem;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

a.dsm-advertisement-seller__name:hover,
a.dsm-advertisement-seller__name:focus-visible {
    color: var(--dsm-detail-primary);
}

.dsm-advertisement-seller__member-since {
    display: block;
    margin-top: 4px;
    color: var(--dsm-detail-muted);
    font-size: 0.8rem;
}

.dsm-advertisement-seller__rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 18px;
    color: var(--dsm-detail-muted);
    font-size: 0.88rem;
}

.dsm-advertisement-seller__rating .dashicons {
    width: auto;
    height: auto;
    color: #dba617;
    font-size: 18px;
}

.dsm-advertisement-seller__rating strong {
    color: var(--dsm-detail-text);
}

.dsm-advertisement-seller__rating-empty {
    margin: 18px 0 0;
    color: var(--dsm-detail-muted);
    font-size: 0.84rem;
    line-height: 1.5;
}

.dsm-advertisement-detail__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--dsm-detail-border);
    color: var(--dsm-detail-muted);
    font-size: 0.84rem;
}

.dsm-advertisement-detail__footer a {
    color: var(--dsm-detail-primary);
    font-weight: 700;
    text-decoration: none;
}

.dsm-advertisement-detail__footer a:hover,
.dsm-advertisement-detail__footer a:focus-visible {
    color: var(--dsm-detail-primary-dark);
}

.dsm-advertisement-not-found {
    max-width: 760px;
    margin: 40px auto;
    padding: 60px 28px;
    border: 1px dashed var(--dsm-detail-border, #dcdcde);
    border-radius: 16px;
    background: #f6f7f7;
    text-align: center;
}

.dsm-advertisement-not-found > .dashicons {
    width: auto;
    height: auto;
    color: #8c8f94;
    font-size: 54px;
}

.dsm-advertisement-not-found h1 {
    margin: 14px 0 8px;
}

.dsm-advertisement-not-found p {
    margin: 0 0 20px;
    color: #646970;
}

/* Tablets */

@media (max-width: 1050px) {
    .dsm-advertisement-detail__layout,
    .dsm-advertisement-detail__lower {
        grid-template-columns:
            minmax(0, 1.25fr)
            minmax(280px, 0.75fr);
        gap: 22px;
    }

    .dsm-advertisement-gallery__main,
    .dsm-advertisement-gallery__main img,
    .dsm-advertisement-gallery__placeholder {
        min-height: 520px;
    }
}

/* Móviles y tablets verticales */

@media (max-width: 820px) {
    .dsm-advertisement-page__container {
        width: min(100% - 24px, 1440px);
        padding-top: 22px;
    }

    .dsm-advertisement-detail__layout,
    .dsm-advertisement-detail__lower {
        grid-template-columns: 1fr;
    }

    .dsm-advertisement-summary {
        position: static;
    }

    .dsm-advertisement-gallery__main,
    .dsm-advertisement-gallery__main img,
    .dsm-advertisement-gallery__placeholder {
        min-height: 460px;
    }

    .dsm-advertisement-detail__lower {
        margin-top: 22px;
    }
}

@media (max-width: 560px) {
    .dsm-advertisement-page__container {
        width: min(100% - 20px, 1440px);
        padding-top: 16px;
        padding-bottom: 36px;
    }

    .dsm-advertisement-breadcrumbs {
        margin-bottom: 16px;
        font-size: 0.78rem;
    }

    .dsm-advertisement-gallery__main,
    .dsm-advertisement-gallery__main img,
    .dsm-advertisement-gallery__placeholder {
        min-height: 360px;
    }

    .dsm-advertisement-gallery__main {
        border-radius: var(--dsm-detail-radius-medium);
    }

    .dsm-advertisement-gallery__thumbnails {
        grid-template-columns:
            repeat(
                4,
                minmax(0, 1fr)
            );
        gap: 8px;
    }

    .dsm-advertisement-summary,
    .dsm-advertisement-description,
    .dsm-advertisement-seller {
        padding: 18px;
        border-radius: var(--dsm-detail-radius-medium);
    }

    .dsm-advertisement-summary__attributes > div {
        grid-template-columns: 1fr;
        gap: 5px;
    }

    .dsm-advertisement-detail__footer {
        align-items: flex-start;
        flex-direction: column;
    }
}

@media (max-width: 380px) {
    .dsm-advertisement-gallery__thumbnails {
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
    }

    .dsm-advertisement-gallery__main,
    .dsm-advertisement-gallery__main img,
    .dsm-advertisement-gallery__placeholder {
        min-height: 310px;
    }
}

/* ==========================================================
   ANUNCIOS RELACIONADOS
   ========================================================== */

.dsm-related-advertisements {
    margin-top: 36px;
    padding-top: 30px;
    border-top: 1px solid var(--dsm-detail-border, #dcdcde);
}

.dsm-related-advertisements__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 20px;
}

.dsm-related-advertisements__header h2 {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    line-height: 1.2;
}

.dsm-related-advertisements__header p {
    margin: 7px 0 0;
    color: var(--dsm-detail-muted, #646970);
    font-size: 0.92rem;
}

.dsm-related-advertisements__view-all {
    flex: 0 0 auto;
    color: var(--dsm-detail-primary, #2271b1);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
}

.dsm-related-advertisements__view-all:hover,
.dsm-related-advertisements__view-all:focus-visible {
    color: var(--dsm-detail-primary-dark, #135e96);
}

.dsm-related-advertisements__grid {
    display: grid;
    grid-template-columns:
        repeat(
            4,
            minmax(0, 1fr)
        );
    gap: 18px;
}

.dsm-related-advertisement-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--dsm-detail-border, #dcdcde);
    border-radius: var(--dsm-detail-radius-medium, 10px);
    background: var(--dsm-detail-surface, #ffffff);
    box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.05);
    transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
}

.dsm-related-advertisement-card:hover {
    border-color: #b8b8ba;
    box-shadow:
        0 8px 22px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
}

.dsm-related-advertisement-card.is-promoted {
    border-color: #dba617;
}

.dsm-related-advertisement-card__image {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f0f0f1;
    text-decoration: none;
}

.dsm-related-advertisement-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
}

.dsm-related-advertisement-card:hover
.dsm-related-advertisement-card__image img {
    transform: scale(1.025);
}

.dsm-related-advertisement-card__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: #8c8f94;
}

.dsm-related-advertisement-card__placeholder .dashicons {
    width: auto;
    height: auto;
    font-size: 42px;
}

.dsm-related-advertisement-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.dsm-related-advertisement-card__body {
    padding: 15px;
}

.dsm-related-advertisement-card__category {
    display: block;
    margin-bottom: 5px;
    color: var(--dsm-detail-primary, #2271b1);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.dsm-related-advertisement-card__title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
}

.dsm-related-advertisement-card__title a {
    display: -webkit-box;
    overflow: hidden;

    color: var(--dsm-detail-text, #1d2327);
    text-decoration: none;

    -webkit-box-orient: vertical;
    line-clamp: 2;
    -webkit-line-clamp: 2;
}

.dsm-related-advertisement-card__title a:hover,
.dsm-related-advertisement-card__title a:focus-visible {
    color: var(--dsm-detail-primary, #2271b1);
}

.dsm-related-advertisement-card__brand {
    margin: 7px 0 0;
    overflow: hidden;
    color: var(--dsm-detail-muted, #646970);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dsm-related-advertisement-card__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 13px;
}

.dsm-related-advertisement-card__price strong {
    font-size: 1.12rem;
}

.dsm-related-advertisement-card__price del {
    color: var(--dsm-detail-muted, #646970);
    font-size: 0.78rem;
}

@media (max-width: 1050px) {
    .dsm-related-advertisements__grid {
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
    }
}

@media (max-width: 760px) {
    .dsm-related-advertisements__header {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
    }

    .dsm-related-advertisements__grid {
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
        gap: 12px;
    }
}

@media (max-width: 430px) {
    .dsm-related-advertisements__grid {
        grid-template-columns: 1fr;
    }
}

/* ==========================================================
   FICHA ANUNCIO - BLOQUE PRINCIPAL UNIFICADO
   ========================================================== */

.dsm-advertisement-detail__layout {
    grid-template-columns:
        minmax(0, 1.35fr)
        minmax(360px, 0.90fr);

    gap: 0;

    overflow: hidden;

    border:
        1px solid
        var(--dsm-detail-border);

    border-radius:
        var(--dsm-detail-radius-large);

    background:
        var(--dsm-detail-surface);

    box-shadow:
        var(--dsm-detail-shadow);
}


/*
 * La galería forma ahora parte de la tarjeta principal.
 */
.dsm-advertisement-gallery {
    min-width: 0;

    padding:
        24px;
}


/*
 * Eliminamos la apariencia de tarjeta independiente
 * de la imagen principal.
 */
.dsm-advertisement-gallery__main {
    min-height:
        540px;

    border: 0;

    border-radius:
        12px;

    background:
        var(--dsm-detail-background);
}


/*
 * El resumen es la columna derecha del mismo bloque.
 */
.dsm-advertisement-summary {
    position: sticky;

    top:
        24px;

    align-self:
        start;

    padding:
        32px;

    border:
        0;

    border-left:
        1px solid
        var(--dsm-detail-border);

    border-radius:
        0;

    background:
        var(--dsm-detail-surface);

    box-shadow:
        none;
}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 980px) {

    .dsm-advertisement-detail__layout {
        grid-template-columns:
            1fr;
    }

    .dsm-advertisement-summary {
        position:
            static;

        border-left:
            0;

        border-top:
            1px solid
            var(--dsm-detail-border);
    }

}


@media (max-width: 650px) {

    .dsm-advertisement-gallery {
        padding:
            12px;
    }

    .dsm-advertisement-summary {
        padding:
            22px;
    }

    .dsm-advertisement-detail__layout {
        border-radius:
            14px;
    }

}


