 * @var bool $buyerHasWhatsappContact
 * @var bool $buyerWhatsappMissingPhone
 * @var bool $buyerWhatsappDisabled
 * @var string $reservationStatus
 * @var string $reservationError
 */

$storeUrl =
    home_url(
        '/tienda/'
        . rawurlencode(
            $store->getSlug()
        )
        . '/'
    );

$productUrl =
    home_url(
        '/tienda/'
        . rawurlencode(
            $store->getSlug()
        )
        . '/'
        . rawurlencode(
            $product->getSlug()
        )
        . '/'
    );

/*
 * ============================================================
 * IMÁGENES VÁLIDAS
 * ============================================================
 *
 * Puede haber relaciones antiguas cuyo attachment de WordPress
 * ya no exista. No deben romper la galería.
 */

$validImages = [];

foreach ($images as $image) {
    $attachmentId =
        $image->getAttachmentId();

    $attachmentUrl =
        wp_get_attachment_image_url(
            $attachmentId,
            'large'
        );

    if (
        !is_string($attachmentUrl)
        || $attachmentUrl === ''
    ) {
        continue;
    }

    $validImages[] = $image;
}

/*
 * Portada efectiva.
 *
 * Si la marcada como portada ya no existe,
 * utilizamos la primera imagen válida.
 */
$effectiveCover = null;

if ($coverImage !== null) {
    $coverUrl =
        wp_get_attachment_image_url(
            $coverImage->getAttachmentId(),
            'large'
        );

    if (
        is_string($coverUrl)
        && $coverUrl !== ''
    ) {
        $effectiveCover =
            $coverImage;
    }
}

if (
    $effectiveCover === null
    && $validImages !== []
) {
    $effectiveCover =
        $validImages[0];
}

/*
 * ============================================================
 * MATRIZ DE VARIANTES
 * ============================================================
 */

$variantData = [];

$sizes = [];

foreach ($variants as $variant) {
    $size =
        trim(
            (string) (
                $variant->getSizeValue()
                ?? ''
            )
        );

    $color =
        trim(
            (string) (
                $variant->getColorValue()
                ?? ''
            )
        );

    /*
     * Permitimos productos sin talla/color,
     * pero utilizamos etiquetas internas estables.
     */
    $sizeKey =
        $size !== ''
            ? $size
            : '__none__';

    $colorKey =
        $color !== ''
            ? $color
            : '__none__';

    if (!isset($sizes[$sizeKey])) {
        $sizes[$sizeKey] =
            $size !== ''
                ? $size
                : 'Única';
    }

    $price =
        $variant->hasSpecificPrice()
            ? (float) $variant->getPrice()
            : $product->getDefaultPrice();

    $originalPrice =
        $variant->hasSpecificOriginalPrice()
            ? $variant->getOriginalPrice()
            : $product->getOriginalPrice();

    $availableStock =
        $variant->tracksStock()
            ? $variant->getAvailableStock()
            : null;

    $variantData[] = [
        'id' =>
            $variant->getId(),

        'size_key' =>
            $sizeKey,

        'size_label' =>
            $size !== ''
                ? $size
                : 'Única',

        'color_key' =>
            $colorKey,

        'color_label' =>
            $color !== ''
                ? $color
                : 'Único',

        'price' =>
            $price,

        'original_price' =>
            $originalPrice,

        'stock' =>
            $availableStock,

        'tracks_stock' =>
            $variant->tracksStock(),

        'nonce' =>
            wp_create_nonce(
                PublicReservationController::
                    getNonceAction(
                        $store->getId(),
                        $variant->getId()
                    )
            ),
    ];
}

$hasVariants =
    $variantData !== [];

$initialPrice =
    $product->getDefaultPrice();

$initialOriginalPrice =
    $product->getOriginalPrice();
