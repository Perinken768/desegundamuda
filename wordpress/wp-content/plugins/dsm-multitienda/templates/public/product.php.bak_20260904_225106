<script>
(function () {
    'use strict';

    const root =
        document.querySelector(
            '[data-dsm-store-product]'
        );

    if (!(root instanceof HTMLElement)) {
        return;
    }

    /*
     * ========================================================
     * GALERÍA
     * ========================================================
     */

    const mainImage =
        root.querySelector(
            '[data-dsm-product-main-image]'
        );

    const thumbnails =
        root.querySelectorAll(
            '[data-dsm-product-thumbnail]'
        );

    thumbnails.forEach(
        function (thumbnail) {
            thumbnail.addEventListener(
                'click',
                function () {
                    if (
                        !(
                            thumbnail
                            instanceof HTMLButtonElement
                        )
                    ) {
                        return;
                    }

                    const imageUrl =
                        String(
                            thumbnail.dataset.image
                            || ''
                        );

                    if (
                        imageUrl === ''
                        || !(
                            mainImage
                            instanceof HTMLImageElement
                        )
                    ) {
                        return;
                    }

                    mainImage.src =
                        imageUrl;

                    thumbnails.forEach(
                        function (item) {
                            item.classList.remove(
                                'is-active'
                            );
                        }
                    );

                    thumbnail.classList.add(
                        'is-active'
                    );
                }
            );
        }
    );


    /*
     * ========================================================
     * VARIANTES
     * ========================================================
     */

    const selector =
        root.querySelector(
            '.dsm-product-selector'
        );

    if (!(selector instanceof HTMLElement)) {
        return;
    }

    let variants = [];

    try {
        variants =
            JSON.parse(
                selector.dataset.variants
                || '[]'
            );
    } catch (error) {
        variants = [];
    }

    if (!Array.isArray(variants)) {
        return;
    }

    const sizeButtons =
        Array.from(
            selector.querySelectorAll(
                '[data-dsm-size]'
            )
        );

    const colorContainer =
        selector.querySelector(
            '[data-dsm-color-options]'
        );

    const stockElement =
        selector.querySelector(
            '[data-dsm-product-stock]'
        );

    const priceElement =
        selector.querySelector(
            '[data-dsm-product-price]'
        );

    const originalPriceElement =
        selector.querySelector(
            '[data-dsm-product-original-price]'
        );

    const variantInput =
        selector.querySelector(
            '[data-dsm-variant-id]'
        );

    const nonceInput =
        selector.querySelector(
            '[data-dsm-variant-nonce]'
        );

    const quantityInput =
        selector.querySelector(
            '[data-dsm-quantity]'
        );

    const reserveButton =
        selector.querySelector(
            '[data-dsm-reserve-button]'
        );

    let selectedSize =
        '';

    let selectedColor =
        '';


    function formatPrice(value) {
        return new Intl.NumberFormat(
            'es-ES',
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            }
        ).format(
            Number(value || 0)
        ) + ' €';
    }


    function variantsForSize(size) {
        return variants.filter(
            function (variant) {
                return String(
                    variant.size_key
                ) === size;
            }
        );
    }


    function findSelectedVariant() {
        return variants.find(
            function (variant) {
                return (
                    String(
                        variant.size_key
                    ) === selectedSize
                    &&
                    String(
                        variant.color_key
                    ) === selectedColor
                );
            }
        ) || null;
    }


    function resetReservation() {
        if (
            variantInput
            instanceof HTMLInputElement
        ) {
            variantInput.value = '';
        }

        if (
            nonceInput
            instanceof HTMLInputElement
        ) {
            nonceInput.value = '';
        }

        if (
            quantityInput
            instanceof HTMLInputElement
        ) {
            quantityInput.value = '1';
            quantityInput.max = '1';
            quantityInput.disabled = true;
        }

        if (
            reserveButton
            instanceof HTMLButtonElement
        ) {
            reserveButton.disabled = true;

            reserveButton.textContent =
                'Selecciona talla y color';
        }

        if (
            stockElement
            instanceof HTMLElement
        ) {
            stockElement.textContent =
                'Selecciona talla y color';
        }
    }


    function updateVariant() {
        resetReservation();

        if (
            selectedSize === ''
            || selectedColor === ''
        ) {
            return;
        }

        const variant =
            findSelectedVariant();

        if (!variant) {
            return;
        }

        if (
            priceElement
            instanceof HTMLElement
        ) {
            priceElement.textContent =
                formatPrice(
                    variant.price
                );
        }

        if (
            originalPriceElement
            instanceof HTMLElement
        ) {
            const originalPrice =
                variant.original_price !== null
                    ? Number(
                        variant.original_price
                    )
                    : null;

            const price =
                Number(
                    variant.price
                );

            if (
                originalPrice !== null
                && originalPrice > price
            ) {
                originalPriceElement.textContent =
                    formatPrice(
                        originalPrice
                    );

                originalPriceElement.hidden =
                    false;
            } else {
                originalPriceElement.hidden =
                    true;
            }
        }

        if (
            variantInput
            instanceof HTMLInputElement
        ) {
            variantInput.value =
                String(
                    variant.id
                );
        }

        if (
            nonceInput
            instanceof HTMLInputElement
        ) {
            nonceInput.value =
                String(
                    variant.nonce
                );
        }

        const tracksStock =
            Boolean(
                variant.tracks_stock
            );

        const stock =
            tracksStock
                ? Math.max(
                    0,
                    Number(
                        variant.stock
                        || 0
                    )
                )
                : null;

        if (
            stockElement
            instanceof HTMLElement
        ) {
            stockElement.textContent =
                tracksStock
                    ? (
                        stock === 1
                            ? '1 unidad disponible'
                            : stock
                                + ' unidades disponibles'
                    )
                    : 'Disponible';
        }

        if (
            quantityInput
            instanceof HTMLInputElement
        ) {
            quantityInput.disabled =
                false;

            quantityInput.value =
                '1';

            quantityInput.max =
                tracksStock
                    ? String(
                        Math.max(
                            1,
                            stock
                        )
                    )
                    : '999';
        }

        if (
            reserveButton
            instanceof HTMLButtonElement
        ) {
            reserveButton.disabled =
                tracksStock
                && stock <= 0;

            reserveButton.textContent =
                tracksStock
                && stock <= 0
                    ? 'Sin stock'
                    : 'Reservar';
        }
    }


    function renderColors() {
        if (
            !(
                colorContainer
                instanceof HTMLElement
            )
        ) {
            return;
        }

        colorContainer.innerHTML =
            '';

        selectedColor =
            '';

        if (selectedSize === '') {
            const hint =
                document.createElement(
                    'span'
                );

            hint.className =
                'dsm-product-selector__hint';

            hint.textContent =
                'Selecciona primero una talla.';

            colorContainer.appendChild(
                hint
            );

            resetReservation();

            return;
        }

        const matchingVariants =
            variantsForSize(
                selectedSize
            );

        const colors =
            new Map();

        matchingVariants.forEach(
            function (variant) {
                const key =
                    String(
                        variant.color_key
                    );

                if (!colors.has(key)) {
                    colors.set(
                        key,
                        String(
                            variant.color_label
                        )
                    );
                }
            }
        );

        colors.forEach(
            function (label, key) {
                const button =
                    document.createElement(
                        'button'
                    );

                button.type =
                    'button';

                button.className =
                    'dsm-product-option';

                button.dataset.dsmColor =
                    '';

                button.dataset.value =
                    key;

                button.setAttribute(
                    'aria-pressed',
                    'false'
                );

                button.textContent =
                    label;

                button.addEventListener(
                    'click',
                    function () {
                        selectedColor =
                            key;

                        colorContainer
                            .querySelectorAll(
                                '[data-dsm-color]'
                            )
                            .forEach(
                                function (item) {
                                    const active =
                                        item === button;

                                    item.classList.toggle(
                                        'is-selected',
                                        active
                                    );

                                    item.setAttribute(
                                        'aria-pressed',
                                        active
                                            ? 'true'
                                            : 'false'
                                    );
                                }
                            );

                        updateVariant();
                    }
                );

                colorContainer.appendChild(
                    button
                );
            }
        );

        resetReservation();
    }


    sizeButtons.forEach(
        function (button) {
            if (
                !(
                    button
                    instanceof HTMLButtonElement
                )
            ) {
                return;
            }

            button.addEventListener(
                'click',
                function () {
                    selectedSize =
                        String(
                            button.dataset.value
                            || ''
                        );

                    sizeButtons.forEach(
                        function (item) {
                            const active =
                                item === button;

                            item.classList.toggle(
                                'is-selected',
                                active
                            );

                            item.setAttribute(
                                'aria-pressed',
                                active
                                    ? 'true'
                                    : 'false'
                            );
                        }
                    );

                    renderColors();
                }
            );
        }
    );

})();
</script>
