.dsm-home {
    padding-bottom: var(--dsm-space-7);
}

.dsm-home-search {
    padding:
        var(--dsm-space-6)
        0
        var(--dsm-space-5);
    background: var(--dsm-color-surface);
}

.dsm-search {
    display: flex;
    gap: var(--dsm-space-3);
    max-width: 920px;
    margin-inline: auto;
}

.dsm-search__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 54px;

    padding:
        var(--dsm-space-3)
        var(--dsm-space-5);

    color: var(--dsm-color-text);
    background: var(--dsm-color-surface);

    border: 1px solid var(--dsm-color-border);
    border-radius: var(--dsm-radius-lg);
}

.dsm-home-section {
    padding-top: var(--dsm-space-6);
}

.dsm-section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--dsm-space-4);

    margin-bottom: var(--dsm-space-4);
}

.dsm-section-heading h2 {
    margin: 0;
    font-size: var(--dsm-font-size-xl);
}

.dsm-category-strip {
    display: flex;
    gap: var(--dsm-space-3);
    overflow-x: auto;
    padding-bottom: var(--dsm-space-2);
}

.dsm-category-strip > * {
    flex: 0 0 auto;
}

.dsm-home-advertising {
    padding-top: var(--dsm-space-6);
}

.dsm-advertising-slot {
    display: grid;
    min-height: 150px;
    place-items: center;

    color: var(--dsm-color-text-muted);
    background: var(--dsm-color-surface-muted);

    border: 1px dashed var(--dsm-color-border);
    border-radius: var(--dsm-radius-lg);
}

.dsm-listing-tabs {
    display: flex;
    gap: var(--dsm-space-3);
    margin-bottom: var(--dsm-space-5);
}

.dsm-listing-tabs a {
    padding:
        var(--dsm-space-2)
        var(--dsm-space-4);

    background: var(--dsm-color-surface);
    border: 1px solid var(--dsm-color-border);
    border-radius: 999px;

    font-size: var(--dsm-font-size-sm);
    font-weight: 800;
    text-decoration: none;
}

.dsm-empty-state {
    grid-column: 1 / -1;

    padding: var(--dsm-space-6);

    color: var(--dsm-color-text-muted);
    background: var(--dsm-color-surface);

    border: 1px dashed var(--dsm-color-border);
    border-radius: var(--dsm-radius-lg);

    text-align: center;
}

@media (max-width: 600px) {
    .dsm-search {
        flex-direction: column;
    }

    .dsm-search .dsm-button {
        width: 100%;
    }

    .dsm-listing-tabs {
        overflow-x: auto;
    }
}


/* ==========================================================
   CATEGORÍAS DE PORTADA
   ========================================================== */

.dsm-home-category {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;
    padding:
        var(--dsm-space-2)
        var(--dsm-space-5);

    color: var(--dsm-color-primary);
    background: var(--dsm-color-surface);

    border: 1px solid var(--dsm-color-border);
    border-radius: 999px;

    font-size: var(--dsm-font-size-sm);
    font-weight: 800;
    text-decoration: none;

    transition:
        color var(--dsm-transition-fast),
        background-color var(--dsm-transition-fast),
        border-color var(--dsm-transition-fast),
        transform var(--dsm-transition-fast);
}

.dsm-home-category:hover,
.dsm-home-category:focus-visible {
    color: var(--dsm-color-text-inverse);
    background: var(--dsm-color-primary);
    border-color: var(--dsm-color-primary);

    transform: translateY(-1px);
}

/* ==========================================================
   FILTROS DE PORTADA
   ========================================================== */

.dsm-home-filters {
    margin: 24px 0;
}

.dsm-filter-bar {
    display: grid;
    grid-template-columns:
        minmax(180px, 1.4fr)
        minmax(130px, 1fr)
        minmax(130px, 1fr)
        minmax(180px, 1fr)
        auto;
    gap: 14px;
    align-items: end;
    padding: 18px;
    border: 1px solid var(--dsm-color-border);
    border-radius: 18px;
    background: var(--dsm-color-surface);
}

.dsm-filter-field {
    min-width: 0;
}

.dsm-filter-field label {
    display: block;
    margin-bottom: 6px;
    font-size: 0.86rem;
    font-weight: 700;
}

.dsm-filter-field input,
.dsm-filter-field select {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--dsm-color-border);
    border-radius: 10px;
    background: var(--dsm-color-background);
    color: inherit;
}

.dsm-filter-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}


/* ==========================================================
   PESTAÑAS DE RESULTADOS
   ========================================================== */

.dsm-listing-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
}

.dsm-listing-tabs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--dsm-color-border);
    border-radius: 999px;
    background: var(--dsm-color-surface);
    color: inherit;
    text-decoration: none;
    font-weight: 600;
}

.dsm-listing-tabs a:hover,
.dsm-listing-tabs a.is-active {
    border-color: var(--dsm-color-primary);
}

.dsm-listing-tabs a.is-active {
    background: var(--dsm-color-primary);
    color: #fff;
}


/* ==========================================================
   GRID DE RESULTADOS
   ========================================================== */

.dsm-listing-grid {
    display: grid;
    gap: 22px;
}


/* ==========================================================
   TARJETA DE ANUNCIO / PRODUCTO
   ========================================================== */

.dsm-listing-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--dsm-color-border);
    border-radius: 18px;
    background: var(--dsm-color-surface);
    transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease;
}

.dsm-listing-card:hover {
    transform: translateY(-3px);
    border-color: var(--dsm-color-primary);
    box-shadow:
        0 12px 30px
        rgba(0, 0, 0, 0.08);
}

.dsm-listing-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
}

/*
 * La tarjeta puede contener enlaces independientes:
 *
 * - imagen/título -> ficha del artículo
 * - vendedor      -> tienda
 *
 * La estructura vertical pertenece a la tarjeta,
 * no a un enlace que envuelva todo el contenido.
 */
.dsm-listing-card__media-link {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    color: inherit;
    text-decoration: none;
}

.dsm-listing-card__title a {
    color: inherit;
    text-decoration: none;
}

.dsm-listing-card__title a:hover,
.dsm-listing-card__title a:focus-visible {
    text-decoration: underline;
}

.dsm-listing-card__seller-link {
    color: inherit;
    text-decoration: none;
}

.dsm-listing-card__seller-link:hover,
.dsm-listing-card__seller-link:focus-visible {
    text-decoration: underline;
}

.dsm-listing-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--dsm-color-background);
}

.dsm-listing-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.dsm-listing-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.dsm-listing-badge {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    font-size: 0.75rem;
    font-weight: 700;
}

.dsm-listing-badge--promoted {
    font-weight: 800;
}

.dsm-listing-badge--reserved {
    opacity: 0.88;
}

.dsm-listing-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 15px;
}

.dsm-listing-card__title {
    display: -webkit-box;
    overflow: hidden;

    min-height: 2.6em;
    margin: 0 0 7px;

    font-size: 1rem;
    line-height: 1.3;

    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.dsm-listing-card__seller {
    overflow: hidden;
    margin: 0 0 11px;

    color: var(--dsm-color-text-muted);

    font-size: 0.88rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dsm-listing-card__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
}

.dsm-listing-card__price strong {
    font-size: 1.08rem;
}

.dsm-listing-card__price del {
    color: var(--dsm-color-text-muted);
    font-size: 0.86rem;
}


/* ==========================================================
   RESPONSIVE GENERAL
   ========================================================== */

@media (max-width: 760px) {

    .dsm-listing-grid {
        gap: 12px;
    }
}



/* ==========================================================
   PORTADA MÓVIL
   ========================================================== */

@media (max-width: 760px) {

    /*
     * Contenedor
     */

    .dsm-home .dsm-container {
        width: 100%;
        padding-left: 12px;
        padding-right: 12px;
    }


    /*
     * Espaciado general
     */

    .dsm-home-section {
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .dsm-section-heading {
        margin-bottom: 12px;
    }

    .dsm-section-heading h2 {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.25;
    }


    /*
     * Buscador
     */

    .dsm-home-search {
        padding-top: 14px;
        padding-bottom: 8px;
    }

    .dsm-search {
        display: grid;
        grid-template-columns:
            minmax(0, 1fr)
            auto;
        gap: 8px;
        width: 100%;
    }

    .dsm-search__input {
        min-width: 0;
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        font-size: 16px;
        border-radius: 12px;
    }

    .dsm-search .dsm-button {
        min-height: 44px;
        padding: 8px 14px;
        white-space: nowrap;
        border-radius: 12px;
    }


    /*
     * Categorías
     *
     * En móvil se desplazan horizontalmente.
     */

    .dsm-category-strip {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 5px;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .dsm-category-strip::-webkit-scrollbar {
        display: none;
    }

    .dsm-home-category {
        flex: 0 0 auto;
        white-space: nowrap;
    }


    /*
     * Filtros
     */

    .dsm-home-filters {
        margin-top: 14px;
        margin-bottom: 18px;
    }

    .dsm-filter-bar {
        display: grid;
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
        gap: 10px;
        padding: 12px;
        border-radius: 14px;
    }

    .dsm-filter-field {
        min-width: 0;
    }

    .dsm-filter-field label {
        margin-bottom: 4px;
        font-size: 0.76rem;
    }

    .dsm-filter-field input,
    .dsm-filter-field select {
        width: 100%;
        min-width: 0;
        min-height: 42px;
        padding: 8px 9px;
        font-size: 16px;
        border-radius: 9px;
    }

    .dsm-filter-actions {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns:
            1fr
            1fr;
        gap: 8px;
    }

    .dsm-filter-actions .dsm-button {
        width: 100%;
        min-height: 42px;
        padding: 8px 10px;
        text-align: center;
    }


    /*
     * Pestañas
     */

    .dsm-listing-tabs {
        display: grid;
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
        gap: 6px;
        margin-bottom: 14px;
    }

    .dsm-listing-tabs a {
        min-width: 0;
        min-height: 38px;
        padding: 7px 5px;
        font-size: 0.86rem;
        text-align: center;
    }


    /*
     * Grid tipo marketplace
     */

    .dsm-listing-grid {
        display: grid;
        gap: 10px;
    }


    /*
     * Tarjetas compactas
     */

    .dsm-listing-card {
        min-width: 0;
        border-radius: 12px;
    }

    .dsm-listing-card:hover {
        transform: none;
        box-shadow: none;
    }

    .dsm-listing-card__media {
        aspect-ratio: 3 / 4;
    }

    .dsm-listing-card__body {
        padding: 9px;
    }

    .dsm-listing-card__title {
        display: -webkit-box;
        overflow: hidden;
        margin: 0 0 4px;
        font-size: 0.9rem;
        line-height: 1.25;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .dsm-listing-card__seller {
        overflow: hidden;
        margin: 0 0 6px;
        font-size: 0.76rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dsm-listing-card__price {
        gap: 5px;
    }

    .dsm-listing-card__price strong {
        font-size: 0.98rem;
    }

    .dsm-listing-card__price del {
        font-size: 0.72rem;
    }


    /*
     * Badges
     */

    .dsm-listing-card__badges {
        top: 6px;
        left: 6px;
        right: 6px;
        gap: 4px;
    }

    .dsm-listing-badge {
        min-height: 22px;
        padding: 3px 6px;
        font-size: 0.65rem;
    }


    /*
     * Estados vacíos
     */

    .dsm-empty-state {
        grid-column: 1 / -1;
    }
}


/* ==========================================================
   MÓVILES MUY PEQUEÑOS
   ========================================================== */

@media (max-width: 360px) {

    .dsm-home .dsm-container {
        padding-left: 9px;
        padding-right: 9px;
    }

    .dsm-filter-bar {
        grid-template-columns: 1fr;
    }

    .dsm-filter-actions {
        grid-column: auto;
    }

    .dsm-listing-grid {
        gap: 7px;
    }

    .dsm-listing-card__body {
        padding: 7px;
    }

    .dsm-listing-card__title {
        font-size: 0.84rem;
    }

    .dsm-listing-card__price strong {
        font-size: 0.92rem;
    }
}

/* ==========================================================
   PUBLICIDAD DE PORTADA
   ========================================================== */

.dsm-home-advertising {
    padding-top: var(--dsm-space-6);
}

.dsm-advertising-card {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
}

.dsm-advertising-banner {
    display: block;
    width: 100%;
    overflow: hidden;

    background: var(--dsm-color-surface-muted);
    border-radius: var(--dsm-radius-lg);
    box-shadow: var(--dsm-shadow-sm);
}

.dsm-advertising-banner img {
    display: block;
    width: 100%;
    max-height: 360px;

    object-fit: cover;
    object-position: center;
}

.dsm-advertising-card__actions {
    display: grid;
    grid-template-columns:
        repeat(
            2,
            minmax(0, 1fr)
        );

    gap: var(--dsm-space-3);
    margin-top: var(--dsm-space-4);
}

.dsm-advertising-card__actions .dsm-button {
    width: 100%;
    min-width: 0;
    min-height: 44px;

    justify-content: center;
    text-align: center;
}


/* ==========================================================
   PUBLICIDAD - TABLET
   ========================================================== */

@media (max-width: 760px) {

    .dsm-home-advertising {
        padding-top: var(--dsm-space-5);
    }

    .dsm-advertising-banner img {
        max-height: 260px;
    }

    .dsm-advertising-card__actions {
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );

        gap: 10px;
    }
}


/* ==========================================================
   PUBLICIDAD - MÓVIL
   ========================================================== */

@media (max-width: 520px) {

    .dsm-advertising-banner {
        border-radius: 12px;
    }

    .dsm-advertising-banner img {
        max-height: 220px;
    }

    .dsm-advertising-card__actions {
        grid-template-columns: 1fr;
        gap: 8px;
        margin-top: 10px;
    }

    .dsm-advertising-card__actions .dsm-button {
        min-height: 46px;
    }
}


/* ==========================================================
   TARJETAS - MÓVIL
   ========================================================== */

@media (max-width: 760px) {

    .dsm-listing-card__title {
        min-height: 2.5em;
    }

}


/* ==========================================================
   TARJETAS - PLACEHOLDER SIN IMAGEN
   ========================================================== */

.dsm-listing-card__image--empty {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    color: transparent;
    background: var(--dsm-color-surface-muted);

    font-size: 0;
}

.dsm-listing-card__image--empty::before {
    content: "";

    width: 42px;
    height: 42px;

    background: none;
    border: 2px solid var(--dsm-color-border);
    border-radius: 10px;
}

.dsm-listing-card__image--empty::after {
    content: "";

    position: absolute;

    width: 9px;
    height: 9px;

    border: 2px solid var(--dsm-color-border);
    border-radius: 50%;

    transform: translate(
        -9px,
        -8px
    );
}

@media (max-width: 760px) {

    .dsm-listing-card__image--empty::before {
        width: 36px;
        height: 36px;
    }

    .dsm-listing-card__image--empty::after {
        width: 8px;
        height: 8px;

        transform: translate(
            -8px,
            -7px
        );
    }
}


/* ==========================================================
   CARRUSEL DE PUBLICIDAD
   ========================================================== */

.dsm-advertising-carousel {
    width: 100%;
}

.dsm-advertising-carousel__slide[hidden] {
    display: none;
}

.dsm-advertising-carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;

    margin-top: 12px;
}

.dsm-advertising-carousel__control {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 36px;
    height: 36px;
    padding: 0;

    background: var(--dsm-color-surface);
    border: 1px solid var(--dsm-color-border);
    border-radius: 50%;

    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
}

.dsm-advertising-carousel__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
}

.dsm-advertising-carousel__dot {
    width: 8px;
    height: 8px;
    padding: 0;

    background: var(--dsm-color-border);
    border: 0;
    border-radius: 50%;

    cursor: pointer;
}

.dsm-advertising-carousel__dot.is-active {
    width: 20px;
    border-radius: 999px;
    background: var(--dsm-color-primary);
}

@media (max-width: 520px) {

    .dsm-advertising-carousel__controls {
        margin-top: 10px;
    }

    .dsm-advertising-carousel__control {
        width: 34px;
        height: 34px;
    }
}


/* ==========================================================
   RESULTADOS - COLUMNAS CONFIGURABLES
   ========================================================== */

/*
 * Escritorio amplio.
 *
 * El valor elegido en el Customizer representa el máximo
 * de columnas que puede mostrar la portada.
 */

.dsm-listing-grid--columns-3 {
    grid-template-columns:
        repeat(
            3,
            minmax(0, 1fr)
        );
}

.dsm-listing-grid--columns-4 {
    grid-template-columns:
        repeat(
            4,
            minmax(0, 1fr)
        );
}

.dsm-listing-grid--columns-5 {
    grid-template-columns:
        repeat(
            5,
            minmax(0, 1fr)
        );
}


/*
 * Portátiles y escritorios de anchura media.
 *
 * Una configuración de 5 columnas baja a 4.
 * Las configuraciones de 3 y 4 conservan su máximo.
 */

@media (max-width: 1180px) {

    .dsm-listing-grid--columns-5 {
        grid-template-columns:
            repeat(
                4,
                minmax(0, 1fr)
            );
    }
}


/*
 * Tablet horizontal y portátiles estrechos.
 *
 * Cualquier configuración superior queda limitada
 * a un máximo de 3 columnas.
 */

@media (max-width: 900px) {

    .dsm-listing-grid--columns-4,
    .dsm-listing-grid--columns-5 {
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
    }
}


/*
 * Tablet vertical y móvil.
 *
 * Conservamos las dos columnas del diseño marketplace
 * que ya utiliza la portada móvil.
 */

@media (max-width: 760px) {

    .dsm-listing-grid--columns-3,
    .dsm-listing-grid--columns-4,
    .dsm-listing-grid--columns-5 {
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
    }
}



/* ==========================================================
   PUBLICIDAD - BOTÓN WHATSAPP
   ========================================================== */

.dsm-advertising-card__actions .dsm-button--whatsapp {
    background: #25D366;
    border-color: #25D366;
    color: #ffffff;
}

.dsm-advertising-card__actions .dsm-button--whatsapp:hover,
.dsm-advertising-card__actions .dsm-button--whatsapp:focus-visible {
    background: #1ebe5d;
    border-color: #1ebe5d;
    color: #ffffff;
}


/* ==========================================================
   FICHA PÚBLICA DE PRODUCTO DE TIENDA
   ========================================================== */

.dsm-store-product {
    padding-block: 28px 48px;
}

.dsm-store-product__breadcrumb {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
    font-size: 0.9rem;
}

.dsm-product-detail {
    display: grid;

    grid-template-columns:
        minmax(0, 1.20fr)
        minmax(360px, 0.90fr);

    gap: 0;

    align-items: start;

    border:
        1px solid
        var(--dsm-color-border);

    border-radius:
        22px;

    background:
        var(--dsm-color-surface);

    box-shadow:
        0 10px 30px
        rgba(0, 0, 0, 0.06);
}

.dsm-product-gallery {
    min-width: 0;

    padding:
        24px;
}

.dsm-product-gallery__main {
    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    aspect-ratio:
        1 / 1;

    border-radius:
        14px;

    background:
        var(--dsm-color-surface-muted);
}

.dsm-product-gallery__main img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.dsm-product-gallery__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: var(--dsm-color-text-muted);
}

.dsm-product-gallery__thumbnails {
    display: grid;
    grid-template-columns:
        repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
}

.dsm-product-gallery__thumbnail {
    overflow: hidden;
    padding: 0;
    aspect-ratio: 1;
    border:
        2px solid
        transparent;
    border-radius: 10px;
    background: transparent;
    cursor: pointer;
}

.dsm-product-gallery__thumbnail.is-active {
    border-color:
        var(--dsm-color-primary);
}

.dsm-product-gallery__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.dsm-product-detail__information {
    position: sticky;

    top:
        24px;

    padding:
        32px;

    border-left:
        1px solid
        var(--dsm-color-border);
}

.dsm-product-detail__store {
    display: inline-block;
    margin-bottom: 8px;
    color: var(--dsm-color-text-muted);
}

.dsm-product-detail__title {
    margin:
        0
        0
        14px;
    font-size:
        clamp(
            1.8rem,
            4vw,
            2.8rem
        );
}

.dsm-product-detail__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 28px;
}

.dsm-product-detail__price strong {
    font-size: 1.65rem;
}

.dsm-product-detail__price del {
    color: var(--dsm-color-text-muted);
}

.dsm-product-selector__group {
    margin: 0 0 24px;
    padding: 0;
    border: 0;
}

.dsm-product-selector__group legend {
    margin-bottom: 10px;
    font-weight: 700;
}

.dsm-product-selector__options {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
}

.dsm-product-option {
    min-width: 48px;
    min-height: 44px;
    padding: 9px 14px;
    border:
        1px solid
        var(--dsm-color-border);
    border-radius: 10px;
    background: var(--dsm-color-surface);
    color: inherit;
    font: inherit;
    cursor: pointer;
}

.dsm-product-option:hover {
    border-color:
        var(--dsm-color-primary);
}

.dsm-product-option.is-selected {
    border-color:
        var(--dsm-color-primary);
    background:
        var(--dsm-color-primary);
    color: white;
}

.dsm-product-selector__hint {
    color:
        var(--dsm-color-text-muted);
    font-size: 0.9rem;
}

.dsm-product-selector__stock {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin: 4px 0 22px;
    padding: 14px 0;
    border-top:
        1px solid
        var(--dsm-color-border);
    border-bottom:
        1px solid
        var(--dsm-color-border);
}

.dsm-product-reservation {
    display: grid;
    grid-template-columns:
        110px
        minmax(0, 1fr);
    gap: 12px;
    align-items: end;
}

.dsm-product-reservation__quantity {
    display: grid;
    gap: 6px;
}

.dsm-product-reservation__quantity span {
    font-weight: 700;
}

.dsm-product-reservation__quantity input {
    width: 100%;
    min-height: 46px;
    padding: 8px 10px;
    border:
        1px solid
        var(--dsm-color-border);
    border-radius: 10px;
}

.dsm-product-reservation__button {
    min-height: 46px;
}

.dsm-product-detail__description {
    margin-top: 32px;
    padding-top: 24px;
    border-top:
        1px solid
        var(--dsm-color-border);
}

.dsm-product-detail__description h2 {
    margin-top: 0;
}


/* ==========================================================
   FICHA PRODUCTO - MÓVIL
   ========================================================== */

@media (max-width: 760px) {

    .dsm-store-product {
        padding-block: 14px 30px;
    }

    .dsm-product-detail {
        grid-template-columns:
            1fr;

        gap:
            0;

        border-radius:
            16px;
    }

    .dsm-product-detail__information {
        position:
            static;

        padding:
            22px;

        border-left:
            0;

        border-top:
            1px solid
            var(--dsm-color-border);
    }

    .dsm-product-gallery {
        padding:
            12px;
    }

    .dsm-product-gallery__main {
        border-radius: 12px;
    }

    .dsm-product-gallery__thumbnails {
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
    }

    .dsm-product-reservation {
        grid-template-columns: 1fr;
    }

}
/* ==========================================================
 * DIRECTORIO DE TIENDAS - PORTADA
 * ========================================================== */
/* ==========================================================
 * CARRUSEL DE TIENDAS - PORTADA
 * ========================================================== */

.dsm-home-stores {
    margin: 30px 0 36px;
}

.dsm-home-stores__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 18px;
}

.dsm-home-stores__heading {
    min-width: 0;
}

.dsm-home-stores__heading h3 {
    margin: 0 0 5px;
    color: #15271d;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
}

.dsm-home-stores__heading p {
    max-width: 620px;
    margin: 0;
    color: #68746c;
    font-size: 0.94rem;
    line-height: 1.5;
}


/* ==========================================================
 * FLECHAS
 * ========================================================== */

.dsm-home-stores__controls {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
}

.dsm-home-stores__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid #d5ddd7;
    border-radius: 50%;
    background: #ffffff;
    color: #203a2b;
    cursor: pointer;
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    transition:
        background-color 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        transform 0.18s ease;
}

.dsm-home-stores__arrow:hover:not(:disabled) {
    border-color: #203a2b;
    background: #203a2b;
    color: #ffffff;
    transform: translateY(-1px);
}

.dsm-home-stores__arrow:focus-visible {
    outline: 3px solid rgba(32, 58, 43, 0.22);
    outline-offset: 2px;
}

.dsm-home-stores__arrow:disabled {
    opacity: 0.3;
    cursor: default;
}


/* ==========================================================
 * VIEWPORT Y TRACK
 * ========================================================== */

.dsm-home-stores__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
}

.dsm-home-stores__track {
    display: flex;
    gap: 16px;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 2px 18px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
}

.dsm-home-stores__track::-webkit-scrollbar {
    display: none;
}


/* ==========================================================
 * TARJETA
 * ========================================================== */

.dsm-home-store-card {
    flex:
        0 0
        calc(
            (100% - 48px)
            / 4
        );
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid #d9dfdb;
    border-radius: 16px;
    transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
}

.dsm-home-store-card:hover {
    transform: translateY(-3px);
    border-color: #b8c5bc;
    box-shadow:
        0 10px 28px
        rgba(24, 47, 33, 0.09);
}

.dsm-home-store-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
}

.dsm-home-store-card__link,
.dsm-home-store-card__link:hover,
.dsm-home-store-card__link:focus,
.dsm-home-store-card__link:visited {
    color: inherit;
    text-decoration: none;
}


/* ==========================================================
 * LOGO / IDENTIDAD VISUAL
 * ========================================================== */

.dsm-home-store-card__logo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 155px;
    overflow: hidden;
    background:
        linear-gradient(
            145deg,
            #f6f8f6 0%,
            #eef2ef 100%
        );
    border-bottom: 1px solid #e3e8e4;
}

.dsm-home-store-card__logo img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 20px;
    object-fit: contain;
    object-position: center;
}

.dsm-home-store-card__logo span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: #203a2b;
    color: #ffffff;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    box-shadow:
        0 8px 20px
        rgba(32, 58, 43, 0.16);
}


/* ==========================================================
 * INFORMACIÓN
 * ========================================================== */

.dsm-home-store-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 16px;
}

.dsm-home-store-card__body h4 {
    margin: 0 0 5px;
    overflow: hidden;
    color: #17281e;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dsm-home-store-card__body p {
    margin: 0 0 15px;
    overflow: hidden;
    color: #707b74;
    font-size: 0.85rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dsm-home-store-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    padding: 10px 12px;
    border-radius: 9px;
    background: #203a2b;
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.2;
    transition:
        background-color 0.18s ease;
}

.dsm-home-store-card__action::after {
    content: "→";
    margin-left: 8px;
    font-size: 1rem;
}

.dsm-home-store-card__link:hover
.dsm-home-store-card__action {
    background: #15291d;
}


/* ==========================================================
 * TABLET
 * ========================================================== */

@media (max-width: 1050px) {

    .dsm-home-store-card {
        flex:
            0 0
            calc(
                (100% - 32px)
                / 3
            );
    }

}


/* ==========================================================
 * TABLET PEQUEÑA
 * ========================================================== */

@media (max-width: 760px) {

    .dsm-home-stores {
        margin:
            24px
            0
            30px;
    }

    .dsm-home-stores__header {
        align-items: center;
        gap: 14px;
    }

    .dsm-home-stores__heading p {
        font-size: 0.88rem;
    }

    .dsm-home-store-card {
        flex:
            0 0
            calc(
                (100% - 16px)
                / 2
            );
    }

    .dsm-home-store-card__logo {
        height: 140px;
    }

}


/* ==========================================================
 * MÓVIL
 * ========================================================== */

@media (max-width: 520px) {

    .dsm-home-stores__header {
        align-items: flex-end;
    }

    .dsm-home-stores__heading h3 {
        font-size: 1.08rem;
    }

    .dsm-home-stores__heading p {
        display: none;
    }

    .dsm-home-stores__arrow {
        width: 38px;
        height: 38px;
    }

    .dsm-home-stores__track {
        gap: 12px;
        /*
         * Dejamos ver parte de la siguiente tarjeta
         * para indicar visualmente que hay más tiendas.
         */
        padding-right: 34px;
    }

    .dsm-home-store-card {
        flex:
            0 0
            calc(
                86%
                - 6px
            );
    }

    .dsm-home-store-card__logo {
        height: 145px;
    }

    .dsm-home-store-card__logo img {
        padding: 18px;
    }

    .dsm-home-store-card__body {
        padding: 14px;
    }

}


@media (prefers-reduced-motion: reduce) {

    .dsm-home-stores__track {
        scroll-behavior: auto;
    }

    .dsm-home-store-card,
    .dsm-home-stores__arrow {
        transition: none;
    }

}
